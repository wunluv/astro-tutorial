---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "San's Blog";
import { ghostClient } from '../lib/ghost';
const posts = await ghostClient.posts
    .browse({
        limit: 'all',
    })
    .catch((err) => {
        console.error(err);
    });
---

<BaseLayout pageTitle={pageTitle}>
  <h2>My first blog posts</h2>
  <ul>
        {
            posts.map((post) => (
                <a href={`/${post.slug}`}>
                    <li> {post.title} </li>
                </a>
            ))
        }
        </ul>
</BaseLayout>
